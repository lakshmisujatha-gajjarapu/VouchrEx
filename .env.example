CODE_ENCRYPTION_KEY=replace_with_a_strong_random_secret
PORT=3010
DATABASE_URL=postgresql://vouchrex_user:change_me_strong_password@localhost:5434/vouchrex_db?schema=public
REDIS_URL=redis://:change_me_strong_password@localhost:6380
# Razorpay Payments — collect money from buyers
RAZORPAY_PAYMENT_CALLBACK_URL=vouchrex://payment-callback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX — pay out to sellers (separate keys from Developer Controls in RazorpayX dashboard)
RAZORPAY_X_KEY_ID=
RAZORPAY_X_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=
ADMIN_API_TOKEN=
# OTP / Auth — set OTP_PROVIDER=MSG91_WIDGET in production
OTP_PROVIDER=DEV
OTP_FIXED_CODE=123456
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_CHALLENGE_GRACE_HOURS=24
SESSION_TTL_HOURS=2160
AUDIT_RETENTION_DAYS=7
# Payments & reconciliation
PAYMENT_TIMEOUT_MINUTES=30
STALE_PAYMENT_SYNC_MINUTES=5
# Marketplace economics
PLATFORM_FEE_INR=10
COMMISSION_RATE=0.12
HIGH_VALUE_THRESHOLD_INR=2000
HIGH_VALUE_WINDOW_HOURS=4
# Fraud / velocity limits
BUYER_MAX_ORDERS_PER_HOUR=3
SELLER_MAX_LISTINGS_PER_HOUR=5
LISTING_MIN_EXPIRY_HOURS=48
SELLER_DISPUTE_RATE_THRESHOLD=0.30
SELLER_MIN_SALES_FOR_RATE_CHECK=3
# OTP fraud controls
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=3
OTP_MAX_PER_DEVICE_HOUR=4
OTP_MAX_DISTINCT_PHONES_PER_DEVICE_DAY=3
# Rate limiting (ThrottlerModule)
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL_MS=60000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL_MS=900000
THROTTLE_LONG_LIMIT=500
# Comma-separated list of allowed CORS origins (leave empty to block all browser cross-origin requests)
ALLOWED_ORIGINS=https://vouchrex.in,https://app.vouchrex.in
# MSG91 OTP Widget (OTP_PROVIDER=MSG91_WIDGET in production)
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
