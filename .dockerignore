node_modules
.git
.github

# Never let secrets near the build context
.env
.env.*
!.env.example
terraform/environments/secrets.*.tfvars

# Worker source not needed in any image (keep package.json for Yarn install)
apps/worker
!apps/worker/package.json

# Mobile: exclude heavy/generated dirs but include source for the mobile Dockerfile
apps/mobile/node_modules
apps/mobile/ios
apps/mobile/dist
apps/mobile/.expo

# Build artefacts — builder stage starts fresh
apps/api/dist
apps/api/node_modules
**/*.tsbuildinfo

# Tooling
.expo
.yarn/install-state.gz
package-lock.json
pnpm-lock.yaml

# Docs and design assets
HLD
*.md
Vouchrex
