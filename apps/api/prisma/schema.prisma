generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OtpPurpose {
  LOGIN
}

enum ListingStatus {
  DRAFT
  VERIFYING
  ACTIVE
  RESERVED
  SOLD
  DISPUTED
  REFUNDED
  EXPIRED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

enum OrderStatus {
  INITIATED
  PAYMENT_PENDING
  ESCROW_ACTIVE
  CODE_REVEALED
  CONFIRMED
  AUTO_CONFIRMED
  DISPUTED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  FAILED
}

enum EscrowStatus {
  PENDING
  ACTIVE
  RELEASED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  NOT_APPLICABLE
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutAccountType {
  UPI
  BANK_ACCOUNT
}

enum PaymentProvider {
  RAZORPAY
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeResolution {
  REFUND_BUYER
  RELEASE_TO_SELLER
}

enum NotificationChannel {
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum Platform {
  IOS
  ANDROID
  WEB
}

model User {
  id              String               @id @default(cuid())
  phone           String               @unique
  name            String
  email           String?              @unique
  trustScore      Int                  @default(30)
  tier            String               @default("BRONZE")
  status          UserStatus           @default(ACTIVE)
  disputeCount    Int                  @default(0) // incremented on each dispute raised against this user as seller
  sellerStrikes   Int                  @default(0)
  buyerStrikes    Int                  @default(0)
  payoutHoldUntil DateTime?
  totalSales      Int                  @default(0) // incremented on each confirmed/auto-confirmed sale
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  listings        VoucherListing[]     @relation("SellerListings")
  purchases       Order[]              @relation("BuyerOrders")
  sales           Order[]              @relation("SellerOrders")
  disputes        Dispute[]            @relation("RaisedDisputes")
  sessions        UserSession[]
  notifications   Notification[]
  payoutAccount   SellerPayoutAccount?
  pushTokens      PushToken[]
}

model Brand {
  id                      String           @id @default(cuid())
  name                    String           @unique
  normalizedName          String           @unique
  category                String
  logoUrl                 String?
  autoVerifyEnabled       Boolean          @default(false)
  avgDiscountPercent      Int              @default(20)
  verificationWindowHours Int              @default(2)
  active                  Boolean          @default(true)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  listings                VoucherListing[]
}

model VoucherListing {
  id                 String             @id @default(cuid())
  sellerId           String
  brandId            String
  voucherType        String
  faceValue          Int
  sellingPrice       Int
  discountPercent    Float
  status             ListingStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  expiryDate         DateTime
  proofUrl           String?
  buyerId            String?
  soldAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  seller             User               @relation("SellerListings", fields: [sellerId], references: [id])
  brand              Brand              @relation(fields: [brandId], references: [id])
  codeVault          CodeVault?
  order              Order?
  notifications      Notification[]

  @@index([status, brandId])
  @@index([sellerId, createdAt])
}

model CodeVault {
  id            String         @id @default(cuid())
  listingId     String         @unique
  encryptedCode String
  encryptionIv  String
  encryptionTag String
  codeHash      String         @unique
  viewCount     Int            @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime       @default(now())
  listing       VoucherListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String         @id @default(cuid())
  listingId            String         @unique
  buyerId              String
  sellerId             String
  amount               Int
  platformFee          Int
  commission           Int
  sellerPayout         Int
  status               OrderStatus    @default(PAYMENT_PENDING)
  codeRevealedAt       DateTime?
  verificationDeadline DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  listing              VoucherListing @relation(fields: [listingId], references: [id])
  buyer                User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller               User           @relation("SellerOrders", fields: [sellerId], references: [id])
  payment              Payment?
  dispute              Dispute?
  notifications        Notification[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, verificationDeadline])
}

model Payment {
  id                  String          @id @default(cuid())
  orderId             String          @unique
  razorpayPaymentId   String?
  amount              Int
  method              String
  status              PaymentStatus   @default(PENDING)
  escrowStatus        EscrowStatus    @default(PENDING)
  payoutStatus        PayoutStatus    @default(PENDING)
  razorpayPayoutId    String?
  payoutInitiatedAt   DateTime?
  payoutCompletedAt   DateTime?
  payoutFailureReason String?
  refundStatus        RefundStatus    @default(NOT_APPLICABLE)
  razorpayRefundId    String?
  refundInitiatedAt   DateTime?
  refundCompletedAt   DateTime?
  refundFailureReason String?
  refundAttempts      Int             @default(0)
  provider            PaymentProvider @default(RAZORPAY)
  currency            String          @default("INR")
  razorpayOrderId     String?
  razorpaySignature   String?
  capturedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SellerPayoutAccount {
  id                    String            @id @default(cuid())
  userId                String            @unique
  type                  PayoutAccountType @default(UPI)
  upiId                 String?
  accountHolderName     String?
  bankAccountEncrypted  String?
  razorpayContactId     String?
  razorpayFundAccountId String?
  kycStatus             String            @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id             String             @id @default(cuid())
  orderId        String             @unique
  raisedById     String
  reason         String
  description    String
  evidenceUrls   String[]
  sellerResponse String?
  resolution     DisputeResolution?
  status         DisputeStatus      @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String? // adminId of the admin who resolved this dispute (null for bootstrap token)
  adminAlertedAt DateTime? // set by scheduler when stale-dispute admin alert is sent; prevents repeat alerts
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy       User               @relation("RaisedDisputes", fields: [raisedById], references: [id])
}

model OtpChallenge {
  id                String     @id @default(cuid())
  phone             String
  purpose           OtpPurpose @default(LOGIN)
  provider          String     @default("DEV")
  providerRequestId String?
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int        @default(0)
  deviceId          String? // soft fingerprint from expo-device, for fraud detection
  clientIp          String? // real IP (CF-Connecting-IP / X-Real-IP)
  createdAt         DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([deviceId, createdAt])
  @@index([expiresAt])
}

model UserSession {
  id                     String    @id @default(cuid())
  userId                 String
  // Short-lived access token (~15 min) — sent with every API call
  accessTokenHash        String    @unique
  accessTokenExpiresAt   DateTime
  // Long-lived refresh token (~90 days) — used only to rotate tokens
  refreshTokenHash       String    @unique
  refreshTokenExpiresAt  DateTime
  refreshTokenConsumedAt DateTime? // set on rotation; if presented again = theft detected
  deviceId               String?
  revokedAt              DateTime?
  lastUsedAt             DateTime?
  createdAt              DateTime  @default(now())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  orderId   String?
  listingId String?
  eventType String
  title     String
  message   String
  channel   NotificationChannel @default(PUSH)
  status    NotificationStatus  @default(PENDING)
  metadata  Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  listing   VoucherListing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@index([listingId, createdAt])
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  token      String
  platform   Platform
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         AdminRole      @default(ADMIN)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([eventType])
  @@index([processedAt])
}
