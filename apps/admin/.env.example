# CouponBazaar Admin App — environment variables
# Copy to .env.local and fill in your values

# API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3010

# The admin token is entered by the user in the /login screen.
# It is validated against GET /admin/metrics and stored as an httpOnly cookie.
# It must match ADMIN_API_TOKEN in apps/api/.env
