# Copy to .env.homelab and fill in secrets before running.
# Generate CODE_ENCRYPTION_KEY with: openssl rand -hex 32
# Generate ADMIN_API_TOKEN with: openssl rand -hex 32

# Image
DOCKERHUB_USERNAME=chandrashekar-nallamilli
IMAGE_TAG=latest

# API
PORT=3010
CODE_ENCRYPTION_KEY=replace_with_32_byte_hex_from_openssl_rand_hex_32
ADMIN_API_TOKEN=replace_with_random_secret

# Database
POSTGRES_USER=vouchrex_user
POSTGRES_DB=vouchrex_db
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://vouchrex_user:replace_with_strong_password@db:5432/vouchrex_db?schema=public

# Redis
REDIS_PASSWORD=replace_with_strong_password
REDIS_URL=redis://:replace_with_strong_password@redis:6379

# MinIO
MINIO_ROOT_USER=vouchrex_admin
MINIO_ROOT_PASSWORD=replace_with_strong_password

# OTP — use DEV for homelab testing (fixed code 123456), MSG91_WIDGET for real SMS
OTP_PROVIDER=DEV
OTP_FIXED_CODE=123456
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=2160

# Razorpay — leave blank if not testing payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_X_KEY_ID=
RAZORPAY_X_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=

# MSG91 — only needed when OTP_PROVIDER=MSG91_WIDGET
MSG91_AUTH_KEY=

# CORS — set to your homelab domain or leave empty to block browser cross-origin requests
ALLOWED_ORIGINS=

# Marketplace defaults (safe to leave as-is)
PLATFORM_FEE_INR=10
COMMISSION_RATE=0.12
HIGH_VALUE_THRESHOLD_INR=2000
HIGH_VALUE_WINDOW_HOURS=4
PAYMENT_TIMEOUT_MINUTES=30
STALE_PAYMENT_SYNC_MINUTES=5
AUDIT_RETENTION_DAYS=7
OTP_CHALLENGE_GRACE_HOURS=24
BUYER_MAX_ORDERS_PER_HOUR=3
SELLER_MAX_LISTINGS_PER_HOUR=5
LISTING_MIN_EXPIRY_HOURS=48
SELLER_DISPUTE_RATE_THRESHOLD=0.30
SELLER_MIN_SALES_FOR_RATE_CHECK=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=3
OTP_MAX_PER_DEVICE_HOUR=4
OTP_MAX_DISTINCT_PHONES_PER_DEVICE_DAY=3
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL_MS=60000
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL_MS=900000
THROTTLE_LONG_LIMIT=500
